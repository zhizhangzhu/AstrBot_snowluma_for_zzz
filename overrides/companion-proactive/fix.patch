@@ -0,0 +1,108 @@
+"""Deployment regressions: native OneBot pokes and anonymous AnySearch."""
+import unittest
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, patch
+from astrbot_plugin_private_companion.proactive_engine import ProactiveEngineMixin
+from astrbot_plugin_private_companion.news_exploration import NewsExplorationMixin
+
+class PokeHarness(ProactiveEngineMixin):
+    enable_poke_action = True
+    def __init__(self, client):
+        self.client = client
+    def _resolve_aiocqhttp_client(self):
+        return self.client
+
+class SearchHarness(NewsExplorationMixin):
+    data = {}
+    web_exploration_max_results = 6
+    def __init__(self, key=None):
+        self.settings = {'web_search': True, 'websearch_provider': 'anysearch', 'websearch_anysearch_key': key or []}
+    def _astrbot_web_search_provider_settings(self, umo=''):
+        return self.settings.copy()
+    def _custom_web_exploration_search_configured(self):
+        return False
+    def _web_search_cooldown_remaining(self, provider):
+        return 0
+
+class NativeCompatibilityTests(unittest.IsolatedAsyncioTestCase):
+    def test_native_friend_poke_needs_no_pokepro(self):
+        self.assertTrue(PokeHarness(SimpleNamespace(friend_poke=AsyncMock()))._poke_available())
+    def test_poke_disabled_or_missing_client_stays_unavailable(self):
+        owner = PokeHarness(SimpleNamespace(friend_poke=AsyncMock()))
+        owner.enable_poke_action = False
+        self.assertFalse(owner._poke_available())
+        self.assertFalse(PokeHarness(None)._poke_available())
+    def test_anysearch_anonymous_is_available(self):
+        self.assertTrue(SearchHarness()._astrbot_web_search_available())
+    async def test_anysearch_routes_and_normalizes_results(self):
+        owner = SearchHarness('test-key')
+        search = AsyncMock(return_value=[SimpleNamespace(title='Title', url='https://example.com', snippet='Body')])
+        with patch('astrbot.core.tools.web_search_tools._anysearch_search', search, create=True):
+            results = await owner._run_astrbot_web_search('test query', usage='web_exploration')
+        self.assertEqual(len(results), 1)
+        self.assertEqual(results[0]['provider'], 'anysearch')
+        self.assertEqual(search.call_args.args[0]['websearch_anysearch_key'], ['test-key'])
+        self.assertEqual(search.call_args.args[1]['query'], 'test query')
+    async def test_anysearch_news_content_type(self):
+        search = AsyncMock(return_value=[])
+        with patch('astrbot.core.tools.web_search_tools._anysearch_search', search, create=True):
+            await SearchHarness()._run_astrbot_web_search('news', topic='news')
+        self.assertEqual(search.call_args.args[1]['content_types'], ['news'])
+
+class InternalMemorySchemaTests(unittest.IsolatedAsyncioTestCase):
+    async def test_internal_generation_projects_tools_before_skip(self):
+        from unittest.mock import Mock
+        from astrbot_plugin_memory_companion.core.service import MemoryCompanionService
+        ctx = SimpleNamespace(message_text='background generation', session_id='test')
+        req = SimpleNamespace(system_prompt='')
+        event = SimpleNamespace(private_companion_proactive_framework=True)
+        owner = SimpleNamespace(
+            config=SimpleNamespace(bool=lambda key, default=False: default),
+            identity=SimpleNamespace(resolve_event_context=AsyncMock(return_value=ctx)),
+            capture=None,
+            _private_companion_internal_generation_event=lambda e: True,
+        )
+        for name in [
+            '_mark_memory_companion_injection_state', '_ensure_lifecycle_maintenance_dispatcher',
+            '_ensure_wal_checkpoint_loop', '_ensure_acl_projection_reconcile_loop',
+            '_sanitize_session_context_message_text', '_apply_companion_relationship_projection',
+            '_apply_companion_expression_decision', '_ensure_reconstruction_turn_token',
+            '_apply_private_companion_preferred_address', '_apply_reconstruction_contract',
+            '_emit_hook_stage_timing',
+        ]:
+            setattr(owner, name, Mock())
+        await MemoryCompanionService.handle_llm_request(owner, event, req)
+        owner._apply_reconstruction_contract.assert_called_once_with(req, ctx, event=event)
+
+class ExplicitProxyTests(unittest.IsolatedAsyncioTestCase):
+    async def test_qzone_read_uses_environment_proxy(self):
+        import json
+        from unittest.mock import Mock
+        from astrbot_plugin_private_companion.qzone_runtime import QzoneRuntimeMixin
+        class Qzone(QzoneRuntimeMixin):
+            _qzone_context_from_cookies = staticmethod(lambda value: {'uin': 1, 'cookie_header': value})
+            _qzone_parse_response = staticmethod(json.loads)
+        response = SimpleNamespace(status=200, text=AsyncMock(return_value='{"code":0}'))
+        request_cm = AsyncMock()
+        request_cm.__aenter__.return_value = response
+        session = SimpleNamespace(request=Mock(return_value=request_cm))
+        session_cm = AsyncMock()
+        session_cm.__aenter__.return_value = session
+        with patch('aiohttp.ClientSession', return_value=session_cm) as factory:
+            result = await Qzone()._qzone_request(None, 'GET', 'https://user.qzone.qq.com/test', cookie_header='test')
+        self.assertTrue(factory.call_args.kwargs['trust_env'])
+        self.assertEqual(result['code'], 0)
+
+    async def test_news_reader_uses_environment_proxy(self):
+        from unittest.mock import Mock
+        reader = SearchHarness()
+        response = SimpleNamespace(status=200, text=AsyncMock(return_value='<rss><channel><item><title>Item</title><link>https://example.com</link></item></channel></rss>'))
+        request_cm = AsyncMock()
+        request_cm.__aenter__.return_value = response
+        session = SimpleNamespace(get=Mock(return_value=request_cm))
+        session_cm = AsyncMock()
+        session_cm.__aenter__.return_value = session
+        with patch('aiohttp.ClientSession', return_value=session_cm) as factory:
+            items = await reader._fetch_news_source({'name':'test', 'url':'https://example.com/rss'})
+        self.assertTrue(factory.call_args.kwargs['trust_env'])
+        self.assertEqual(len(items), 1)
