COMPOSE_PROJECT_NAME=xiaoxiaoqing
ASTRBOT_IMAGE=soulter/astrbot:v4.29.1
SNOWLUMA_IMAGE=motricseven7/snowluma:v2.1.1
# Optional local image with Chromium; see runtime/snowluma-browser/README.md
SNOWLUMA_RUNTIME_IMAGE=
BIND_ADDRESS=127.0.0.1
ASTRBOT_PORT=6185
SNOWLUMA_PORT=5099
NOVNC_PORT=6081
BOT_QQ=2893214983
# Actual random credentials are stored in the private .env created during deployment.
ONEBOT_TOKEN=
ONEBOT_HTTP_TOKEN=
VNC_PASSWD=

HAPI_PORT=3006
HAPI_TOKEN=
CODEX_RUNTIME_IMAGE=xiaoxiaoqing-codex-runtime:4.29.1-0.30.7
# Optional: set only after authorizing QQ traffic through your chosen proxy.
QQ_PROXY_FLAG=

# Both the Linux QQ browser and AstrBot session consumer must bind this account.
QQ_ACCOUNT_ID=2893214983
